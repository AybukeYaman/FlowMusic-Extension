{
  "manifest_version": 3,
  "name": "Faded Hours Studio",
  "short_name": "Studio",
  "version": "0.1.0",
  "description": "Plan an album once, run Flow Music sessions in parallel, then download and add songs to a playlist.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "downloads", "alarms"],
  "host_permissions": ["https://www.flowmusic.app/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.flowmusic.app/*"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Studio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
